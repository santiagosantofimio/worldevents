			"dev.santiagosantofimio.worldomens.WorldOmensMod"
		],
		"client": [
			"dev.santiagosantofimio.worldomens.WorldOmensClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
