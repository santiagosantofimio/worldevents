{
	"schemaVersion": 1,
	"id": "worldevents",
	"version": "${version}",
	"name": "World Events",
	"description": "Random world events for servers, with their own creatures and bosses: blood moons, meteor showers, hordes, treasure hunts, Nether eruptions and more. Server-side only: vanilla clients can join.",
	"authors": [
		"Santiago Santofimio"
	],
	"contact": {
		"sources": "https://github.com/santiagosantofimio/worldevents",
		"issues": "https://github.com/santiagosantofimio/worldevents/issues"
	},
	"license": "MIT",
	"icon": "assets/worldevents/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.santiagosantofimio.worldevents.fabric.WorldEventsFabric"
		],
		"client": [
			"dev.santiagosantofimio.worldevents.fabric.WorldEventsFabricClient"
		]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	}
}
